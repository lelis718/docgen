    <!-- Tela inicial (aberta pelo icone) -->
    <string name="setup_title">Como usar o DocGen</string>
    <string name="setup_instructions">1. Selecione fotos, documentos ou textos em qualquer app (Arquivos, Galeria, Gmail…).\n2. Toque em Compartilhar → DocGen → “Gerar um PDF único”.\n3. Confirme o nome e o local: o PDF é gerado na ordem da sua seleção e abre sozinho.\n\nO local padrão abaixo fica pré-marcado toda vez que você gerar um PDF. Para trocá-lo depois, toque no ícone do DocGen novamente.</string>
    <string name="setup_destination">Local padrão para salvar</string>
    <string name="setup_tree">Escolher pasta…</string>
    <string name="setup_save">Salvar</string>
    <string name="setup_close">Fechar</string>
    <string name="setup_saved">Local padrão salvo.</string>

